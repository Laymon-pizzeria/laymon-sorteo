# Clave para entrar a /admin (ver sorteos, crear los de eventos Laymon, bajar contactos)
ADMIN_KEY=
# Firma las sesiones de invitados y organizadores. Cualquier texto largo al azar; si cambia, todos tienen que volver a entrar.
SORTEO_SECRET=
# Base de datos (Upstash Redis, una NUEVA solo para el sorteo). Sin esto se guarda en memoria y se pierde al reiniciar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Correo (Resend): llave y remitente con el dominio verificado, p. ej. Laymon <sorteo@laymonpizzeria.com>
RESEND_API_KEY=
SORTEO_REMITENTE=
# Dominio público sin diagonal final (para los enlaces de los correos)
SORTEO_BASE_URL=https://sorteo.laymonpizzeria.com
WHATSAPP_NUMBER=525535023665
